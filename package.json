{
	"name": "create-hono-app",
	"version": "1.0.0",
	"description": "A top 1% modern Hono backend starter built for seamless deployment on Vercel. Clean, scalable, and developer‑friendly, it delivers edge‑ready performance, minimal boilerplate for rapid prototyping or production apps.",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/app/server.ts",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"verify": "pnpm run lint && pnpm run format && pnpm run check",
		"prepare": "husky"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.0",
		"@hono/swagger-ui": "^0.6.1",
		"@node-rs/argon2": "^2.0.2",
		"dotenv": "^17.4.2",
		"hono": "^4.13.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@types/node": "^26.1.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"tsx": "^4.23.5",
		"typescript": "^5.9.3"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"license": "CC0-1.0",
	"author": "frenzzofficial",
	"repository": {
		"type": "git",
		"url": "https://github.com/frenzzofficial/create-hono-app.git"
	},
	"keywords": [
		"hono",
		"nextjs",
		"bun",
		"typescript",
		"react",
		"frontend",
		"backend",
		"api",
		"starter",
		"template",
		"create-hono-app"
	]
}
